# Copy this file to .env (which is git-ignored) and set local-only values.
DATABASE_USERNAME=unikly_dev
DATABASE_PASSWORD=

# Local-only SMTP capture. The Compose stack sends development mail to Mailpit.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@unikly.com
UNIKLY_PUBLIC_BASE_URL=http://localhost:4200
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Development accounts are disabled unless explicitly enabled.
UNIKLY_SEED_DEV_USERS=false
DEV_CUSTOMER_EMAIL=customer@unikly.com
DEV_CUSTOMER_PASSWORD=
DEV_ADMIN_EMAIL=admin@unikly.com
DEV_ADMIN_PASSWORD=
DEV_SELLER_EMAIL=seller@unikly.com
DEV_SELLER_PASSWORD=
